# ============================================================
# .env.example — Copy thành .env rồi điền giá trị của MÁY BẠN:
#     cp .env.example .env
#
# File .env đã nằm trong .gitignore — TUYỆT ĐỐI KHÔNG commit.
# Lỡ commit = secret coi như đã lộ, phải đổi key mới, không phải chỉ git rm.
#
# Định dạng: KEY=value. KHÔNG dùng dấu nháy ("" hay '') — Spring sẽ coi
# dấu nháy là một phần của giá trị.
# ============================================================


# ─── MỤC A — BẮT BUỘC để chạy backend trên máy cá nhân ──────

# Mật khẩu MySQL trên máy bạn.
# Thiếu biến này app sẽ dừng với lỗi "Access denied for user 'root'@'localhost'".
DB_PASSWORD=


# ─── MỤC A2 — TUỲ CHỌN ───────────────────────────────────────
# Để trống thì app vẫn khởi động bình thường, chỉ hỏng đúng tính năng đó.
# Bỏ dấu # ở đầu dòng nếu muốn dùng.

# Chỉ cần nếu MySQL máy bạn khác cổng / tên DB / user mặc định.
# CẢNH BÁO: đừng trỏ vào RDS production, dev chạy DB local.
# DB_URL=jdbc:mysql://localhost:3306/m6_thermal_power_plant?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh
# DB_USERNAME=root

# Cloudinary — cần khi làm chức năng xuất/lưu PDF phiếu công tác.
# Lấy giá trị trong tin nhắn ghim của nhóm (là key DEV, khác key production).
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Gmail SMTP — cần khi làm chức năng nhắc trả CCDC quá hạn.
# MAIL_PASSWORD phải là "App Password" của Google, không phải mật khẩu đăng nhập.
# MAIL_USERNAME=
# MAIL_PASSWORD=


# ─── MỤC B — KHÔNG cần cho dev thường ────────────────────────
# Chỉ dùng khi chạy `docker-compose up` hoặc deploy (xem docker-compose.yml).
# docker-compose dùng chung DB_USERNAME / DB_PASSWORD / MAIL_* khai ở mục A.

# DB_ROOT_PASSWORD=change_me_root_password
# JWT_SECRET=            # tạo secret mạnh: openssl rand -base64 64
# AWS_REGION=ap-northeast-1
# AWS_ACCOUNT_ID=197826770971
# ECR_REGISTRY=197826770971.dkr.ecr.ap-northeast-1.amazonaws.com
# S3_BUCKET=thermal-power-plant-frontend
# CLOUDFRONT_DISTRIBUTION_ID=E1ABCDEF2GHIJK
